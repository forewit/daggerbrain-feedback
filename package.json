{
  "name": "daggerbrain-feedback",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bug bot built on Cloudflare Workers, Hono, and D1.",
  "type": "module",
  "scripts": {
    "dev": "npm run ui:assets && NODE_TLS_REJECT_UNAUTHORIZED=0 wrangler dev",
    "deploy": "npm run ui:assets && NODE_TLS_REJECT_UNAUTHORIZED=0 wrangler deploy",
    "postdeploy": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --env-file=.env scripts/register-commands.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply daggerbrain_feedback --local",
    "db:migrate:remote": "wrangler d1 migrations apply daggerbrain_feedback --remote",
    "register-commands": "node --env-file=.env scripts/register-commands.mjs",
    "test": "npm run ui:assets && vitest run",
    "typecheck": "npm run ui:assets && tsc --noEmit",
    "ui:assets": "tailwindcss -i ./src/ui/globals.css -o ./src/ui/generated.css --minify && node ./scripts/build-ui-assets.mjs"
  },
  "keywords": [
    "cloudflare-workers",
    "discord",
    "hono",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord-api-types": "^0.38.31",
    "discord-interactions": "^4.4.0",
    "hono": "^4.12.8",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tailwindcss/cli": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.75.0"
  }
}
